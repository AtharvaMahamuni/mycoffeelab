---
import BaseLayout from "../../components/BaseLayout.astro";
import { breadcrumbNode, graph, personNode } from "../../lib/schema";
import { url } from "../../lib/site";

const description = "Three coffee calculators: brew ratio, espresso yield, and cold brew.";
const crumbs = [
  { href: "/", label: "Home" },
  { label: "Coffee calculators" },
];
const jsonLd = graph(
  personNode(),
  breadcrumbNode([
    { name: "Home", path: "/" },
    { name: "Coffee calculators", path: "/calculators/" },
  ]),
);
---

<BaseLayout title="Coffee calculators" description={description} path="/calculators/" crumbs={crumbs} jsonLd={jsonLd}>
  <h1>Coffee calculators</h1>
  <ul class="card-list">
    <li><a href={url("/calculators/coffee-to-water-ratio/")}>Coffee to water ratio calculator<p>SCA center by default. Shop ratios are labeled as shop ratios.</p></a></li>
    <li><a href={url("/calculators/espresso-ratio/")}>Espresso ratio calculator<p>Dose in, yield out. Time is a sentence, not a formula.</p></a></li>
    <li><a href={url("/calculators/cold-brew-ratio/")}>Cold brew ratio calculator<p>Concentrate or ready to drink, minus the water the grounds hold.</p></a></li>
    <li><a href={url("/calculators/caffeine-half-life-calculator/")}>Caffeine half-life calculator<p>Track active bloodstream caffeine and predict sleep disruption based on pharmacokinetic half-life decay.</p></a></li>
    <li><a href={url("/calculators/espresso-dial-in-calculator/")}>Espresso dial-in calculator<p>Troubleshoot sour, bitter, or fast shots with precision flow rate diagnostics.</p></a></li>
    <li><a href={url("/calculators/coffee-grind-size-chart/")}>Coffee grind size chart<p>Universal particle micron converter for Fellow Ode, Baratza Encore, and Comandante.</p></a></li>
    <li><a href={url("/calculators/iced-coffee-calculator/")}>Iced coffee ratio calculator<p>Japanese flash brew calculator: balance ice and hot water with zero dilution.</p></a></li>
  </ul>
</BaseLayout>
