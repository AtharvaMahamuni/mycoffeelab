---
import "../styles/global.css";
import { jsonLdScript, SITE_NAME, absolute } from "../lib/site";

interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  crumbs?: Crumb[];
  jsonLd?: unknown;
}

const { title, description, path, crumbs = [], jsonLd } = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const canonical = absolute(path);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FBF8F4" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {jsonLd && <script type="application/ld+json" set:html={jsonLdScript(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-row">
        <a class="wordmark" href="/">MyCoffeeLab</a>
        <nav aria-label="Primary">
          <ul class="nav-list">
            <li><a href="/calculators/">Calculators</a></li>
            <li><a href="/types-of-coffee/">Drinks</a></li>
            <li><a href="/compare/">Comparisons</a></li>
            <li><a href="/about/">About</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <div class="shell">
      {
        crumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            <ol>
              {crumbs.map((crumb, index) => (
                <li>
                  {crumb.href && index < crumbs.length - 1 ? (
                    <a href={crumb.href}>{crumb.label}</a>
                  ) : (
                    <span aria-current="page">{crumb.label}</span>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <main id="content">
        <slot />
      </main>
    </div>
    <footer class="site-footer">
      <div class="shell footer-row">
        <span>Published by Atharva Mahamuni.</span>
        <a href="/about/">About the house defaults</a>
        <a href="/corrections/">Corrections</a>
      </div>
    </footer>
  </body>
</html>
